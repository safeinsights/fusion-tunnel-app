# Enclave-local listen port for the provisioning API (/local/*) and the RC-facing local API (/v1/*)
PORT=3003

# Protocol tuning — every value is PROVISIONAL (v2 §15.6) and env-overridable; see src/config.ts
# FUSION_INLINE_CAP_BYTES=262144
# FUSION_PAD_BUCKETS=1024,2048,4096,8192,16384,32768
# FUSION_INFLIGHT_MAX_MSGS=64
# FUSION_INFLIGHT_MAX_BYTES=33554432
# FUSION_ROUND_TIMEOUT_MS=600000
# FUSION_LONGPOLL_MS=25000
# FUSION_HEARTBEAT_MS=30000
# FUSION_HEARTBEAT_MISSES=2
# FUSION_RECONNECT_MIN_MS=500
# FUSION_RECONNECT_MAX_MS=30000
# FUSION_TOKEN_REFRESH_LEAD_MS=120000
# FUSION_STATUS_INTERVAL_MS=60000
# FUSION_PEERKEY_POLL_MS=5000
# FUSION_CLOSE_TIMEOUT_MS=30000
# FUSION_HANDSHAKE_RETRY_MS=2000
# FUSION_HANDSHAKE_MAX_ATTEMPTS=300
